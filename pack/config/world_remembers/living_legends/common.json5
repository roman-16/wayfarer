  },
  // Chat notifications shown when a new place is automatically created.
  "notifications": {
    // Lore-style chat messages for newly created places. This does not affect generation.
    "placeCreated": {
      // Turns new-place chat messages on or off.
      "enabled": true,
      // If true, all online players receive new-place messages.
      "sendToAllPlayers": true,
      // If true, only nearby players in the same dimension receive messages.
      "sendToNearbyPlayersOnly": false,
      // Nearby notification radius, in blocks. 0 means only exact-position checks where applicable.
      "nearbyRadiusBlocks": 256,
      // If true, messages include a small coordinate hint.
      "includeCoordinates": true,
      // If true, messages include the dimension id.
      "includeDimension": false,
      // If true, messages include the place type.
      "includePlaceType": false,
      // If true, manual /places create can show notifications in future command paths.
      "notifyManualCreate": false,
      // Maximum new-place messages per minute. 0 disables rate limiting.
      "maxNotificationsPerMinute": 5,
      // Per-place-type notification toggles. Disabling a type only hides messages.
      "perType": {
        // If false, this place type will not send place-created chat messages.
        "DEATH_SITE": true,
        // If false, this place type will not send place-created chat messages.
        "BATTLEFIELD": true,
        // If false, this place type will not send place-created chat messages.
        "SLAUGHTER_FIELD": true,
        // If false, this place type will not send place-created chat messages.
        "PVP_ARENA": true,
        // If false, this place type will not send place-created chat messages.
        "MINING_SITE": true,
        // If false, this place type will not send place-created chat messages.
        "PORTAL_LANDMARK": true,
        // If false, this place type will not send place-created chat messages.
        "GENERAL_LANDMARK": true,
        // If false, this place type will not send place-created chat messages.
        "FIRST_DISCOVERY": true,
        // If false, this place type will not send place-created chat messages.
        "BOSS_SITE": true,
        // If false, this place type will not send place-created chat messages.
        "PET_MEMORIAL": true,
        // If false, this place type will not send place-created chat messages.
        "NAMED_MOB_MEMORIAL": true,
        // If false, this place type will not send place-created chat messages.
        "RAID_SITE": true,
        // If false, this place type will not send place-created chat messages.
        "DIMENSION_THRESHOLD": true,
        // If false, this place type will not send place-created chat messages.
        "SETTLEMENT": true,
        // If false, this place type will not send place-created chat messages.
        "CUSTOM": false
      }
    }
  },
  // Server-side title overlay checks. Only saved NamedPlace objects can trigger titles.
  "titleOverlay": {
    // Turns NamedPlace title overlay packets on or off.
    "enabled": false,
    // How often the server checks whether players entered a named place. Values below 1 reset to 10; values above 200 are clamped.
    "checkIntervalTicks": 10,
    // Small places use at least this radius for title entry checks. Must be positive.
    "minTitleRadius": 24,
    // Extra radius used only for leaving a place. Prevents title border flicker. Values below 0 are clamped.
    "exitPaddingBlocks": 8,
    // Minimum time between any two title overlays for one player.
    "globalCooldownTicks": 100,
    // Minimum time before the same place can show again for one player.
    "samePlaceCooldownTicks": 12000,
    // Longer repeat cooldown for GENERAL_LANDMARK titles because they are background travel content.
    "generalLandmarkCooldownTicks": 24000,
    // Delay after teleport or dimension change before entry titles can appear.
    "teleportDelayTicks": 40,
    // If true, entering a saved NamedPlace can show a title.
    "showOnEnter": true,
    // If true, a newly created saved NamedPlace can show a title to players inside it.
    "showOnPlaceCreated": true,
    // If true, GENERAL_LANDMARK places may show titles.
    "showGeneralLandmarks": true,
    // If true, GENERAL_LANDMARK titles are suppressed when a more specific place also contains the player.
    "generalLandmarkOnlyIfNoHigherPriority": true,
    // Y-distance tolerance for horizontal title checks. Cave/mining/portal-like places still use 3D distance.
    "verticalToleranceBlocks": 48
  },
  // Optional client map integrations. These settings are server-controlled and safe when a map mod is missing.
  "mapIntegration": {
    // Master switch for all optional map integration output.
    "enabled": true,
    // JourneyMap-specific settings. JourneyMap remains optional and client-side.
    "journeyMap": {
      // If true, clients with JourneyMap may receive Living Legends map labels and destinations.
      "enabled": true
    },
    // Xaero-specific settings. Xaero's Minimap remains optional and client-side.
    "xaero": {
      // If true, clients with Xaero's Minimap can set one manual destination waypoint from the journal.
      "enabled": true
    },
    // FTB Chunks-specific settings. FTB Chunks remains optional and client-side.
    "ftbChunks": {
      // If true, clients with FTB Chunks can set one manual destination waypoint from the journal.
      "enabled": true
    },
    // Persistent per-player map labels for places the player has discovered. Xaero and FTB Chunks do not use these labels.
    "placeLabels": {
      // If true, discovered places can appear as map labels in providers that support labels, currently JourneyMap.
      "enabled": true,
      // If true, GENERAL_LANDMARK labels can appear on the map. False keeps background landmarks hidden by default.
      "showGeneralLandmarks": false,
      // If true, supported map labels include hover text.
      "showTooltips": true,
      // Reserved for map providers that support technical hover fields. JourneyMap labels keep hover text player-facing.
      "showCoordinatesInTooltip": true,
      // Reserved for map providers that support technical hover fields. JourneyMap labels keep hover text player-facing.
      "showDimensionInTooltip": true,
      // If true, supported label hover text may include the place type.
      "showPlaceTypeInTooltip": true
    },
    // Temporary destinations players set manually from the World Journal.
    "destinations": {
      // If true, supported map mods can create temporary personal destinations from the journal.
      "enabled": true,
      // If true, setting a new Living Legends destination clears previous Living Legends destinations.
      "onlyOneActiveDestination": true,
      // If true, destinations clear once the player enters the saved place radius.
      "clearWhenEnteringPlaceRadius": true,
      // Fallback distance for clearing a destination, in blocks. Values outside 1 to 1024 reset to 16.
      "fallbackClearDistanceBlocks": 16
    }
  },
  // Future decay settings for old importance.
  "decay": {
    // Decay setting. Existing places are kept unless future decay logic says otherwise.
    "enabled": false,
    // Decay setting. Existing places are kept unless future decay logic says otherwise.
    "inactiveDaysBeforeDecay": 30,
    // Decay setting. Existing places are kept unless future decay logic says otherwise.
    "dailyScoreRetention": 0.995,
    // Decay setting. Existing places are kept unless future decay logic says otherwise.
    "minimumScoreAfterDecay": 10.0
  },
  // Candidate decay affects only activity that has not yet become a NamedPlace. Existing named places are never reduced, renamed, or removed by candidate decay.
  "candidateDecay": {
    // If true, stale unpromoted candidate activity can fade after the grace period.
    "enabled": true,
    // How often stale candidate activity loses score, in ticks. Values below 20 reset to the safe default 24000. 24000 ticks = 1 Minecraft day.
    "intervalTicks": 24000,
    // How long fresh unpromoted activity is protected before decay can start. Values below 0 are clamped.
    "gracePeriodTicks": 1728000,
    // Base score removed each interval before applying the place-type multiplier. Values below 0 are clamped.
    "baseDecayPerInterval": 1.0,
    // Lowest score candidate decay may leave behind.
    "minCandidateScore": 0.0,
    // If true, very small candidate scores are clamped to the minimum candidate score.
    "pruneBelowScore": true,
    // Candidate scores at or below this value are treated as empty when pruning is enabled.
    "pruneThreshold": 0.1,
    // If true, decay passes print one compact summary. Keep false on normal servers.
    "debugLogging": false,
    // Per-place-type decay multipliers for unpromoted candidates only. Set a multiplier to 0 to disable decay for that type.
    "typeMultipliers": {
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "DEATH_SITE": 1.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "BATTLEFIELD": 1.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "SLAUGHTER_FIELD": 1.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "PVP_ARENA": 0.8,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "MINING_SITE": 1.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "PORTAL_LANDMARK": 0.5,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "GENERAL_LANDMARK": 1.2,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "SETTLEMENT": 0.3,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "FIRST_DISCOVERY": 0.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "BOSS_SITE": 0.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "PET_MEMORIAL": 0.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "NAMED_MOB_MEMORIAL": 0.0,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "RAID_SITE": 0.4,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "DIMENSION_THRESHOLD": 0.5,
      // Decay multiplier for this place type. Existing NamedPlace objects are protected regardless of this value.
      "CUSTOM": 0.0
    }
  },
  // World Journal item and GUI settings.
  "journal": {
    // If true, players can open the World Journal item GUI.
    "enabled": true,
    // ALL_KNOWN shows all active places. VISITED_BY_PLAYER shows only places discovered by that player.
    "visibilityMode": "ALL_KNOWN",
    // Controls who may rename/delete/restore names through the journal: SINGLEPLAYER_OWNER_AND_OP, OP_ONLY, ALL_PLAYERS, or DISABLED.
    "managementMode": "SINGLEPLAYER_OWNER_AND_OP",
    // Upper limit for places returned per journal page. Values outside 5 to 100 reset to the safe default 20. The book UI currently caps visible pages at 4 entries for readability.
    "pageSize": 20,
    // If true, journal details can show exact saved place coordinates.
    "showExactCoordinates": true,
    // If true, OPs and cheat-enabled players can teleport from the journal.
    "allowTeleportForOps": true,
    // Maximum length for names entered through the journal rename button. Values outside 8 to 128 reset to the safe default 64.
    "maxManualNameLength": 64
  },
  // Legacy permission settings used by older commands.
  "permissions": {
    // Permission setting. OP levels are from 0 to 4.
    "reloadPermissionLevel": 2,
    // Permission setting. OP levels are from 0 to 4.
    "exportPermissionLevel": 2,
    // Permission setting. OP levels are from 0 to 4.
    "allowClientPlaceQueries": true
  },
  // Debug settings for development. Keep disabled on public servers.
  "debug": {
    // Enables debug logs for development. Keep false on public servers.
    "enabled": false,
    // Debug logging option.
    "logConfigLoad": true,
    // Debug logging option.
    "logGeneratedNames": false,
    // Debug logging option.
    "logScoring": false,
    // Logs detailed naming candidate rejection reasons. Useful for debugging name generation, but can spam logs. Keep disabled on normal servers.
    "namingVerbose": false,
    // Debug logging option.
    "writeDebugExports": false,
    // Uses very low thresholds for testing. Keep false for normal worlds.
    "useTestingThresholds": false
  }
}

