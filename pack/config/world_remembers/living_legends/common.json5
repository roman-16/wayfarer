// World Remembers: Living Legends config.
{
  // Basic mod settings.
  "general": {
    // Turns the mod on or off. If false, new events are ignored.
    "enabled": true,
    // Legacy alias for enabled. Keep it the same as enabled.
    "enableMod": true,
    // Config schema version. Leave this alone unless migrating by hand.
    "configVersion": 4,
    // Preferred language hint for future config/UI text.
    "locale": "en_us",
    // How often Minecraft may autosave world data, in seconds. Values below 30 reset to the safe default 300.
    "autosaveIntervalSeconds": 300
  },
  // Automatic place generation settings. These affect new generation, not existing places.
  "generation": {
    // Config value: generation.enabled.
    "enabled": true,
    // Legacy radius value. The mod stays event-driven and does not scan the world.
    "scanRadiusChunks": 8,
    // Minimum event count used by older generation logic.
    "minEventsForNamedPlace": 4,
    // Maximum generated places per chunk candidate.
    "maxGeneratedPlacesPerChunk": 1,
    // Legacy merge distance in blocks.
    "mergeDistanceBlocks": 96,
    // Default horizontal radius for generated places, in blocks. Must be positive.
    "defaultHorizontalRadiusBlocks": 64,
    // Default vertical radius for generated places, in blocks. Must be positive.
    "defaultVerticalRadiusBlocks": 48,
    // Maximum distance for merging normal area places, in blocks.
    "placeMaxMergeDistanceBlocks": 96,
    // Maximum radius for normal area place clusters, in blocks.
    "placeMaxClusterRadiusBlocks": 64,
    // Maximum center movement on one update, in blocks.
    "placeMaxCenterShiftOnUpdateBlocks": 24,
    // Maximum distance for merging death sites, in blocks.
    "deathSiteMaxMergeDistanceBlocks": 48,
    // Maximum radius for death-site clusters, in blocks.
    "deathSiteMaxClusterRadiusBlocks": 40,
    // Maximum death-site center movement on one update, in blocks.
    "deathSiteMaxCenterShiftOnUpdateBlocks": 12,
    // Minimum Y gap for separate vertical places, in blocks.
    "verticalSeparationMinYGap": 32,
    // If true, death sites may mix cave/surface/etc. False keeps them separate.
    "allowMixedDeathSiteEnvironments": false,
    // Allows UNKNOWN death-site environment to merge with known environments.
    "allowUnknownDeathSiteEnvironmentFallback": false,
    // Maximum merge distance for general landmarks, in blocks.
    "generalLandmarkMaxMergeDistanceBlocks": 48,
    // Maximum cluster radius for general landmarks, in blocks.
    "generalLandmarkMaxClusterRadiusBlocks": 48,
    // Maximum center movement for general landmarks, in blocks.
    "generalLandmarkMaxCenterShiftOnUpdateBlocks": 12,
    // Maximum merge distance for portal landmarks, in blocks.
    "portalLandmarkMaxMergeDistanceBlocks": 48,
    // Maximum radius for portal landmarks, in blocks.
    "portalLandmarkMaxClusterRadiusBlocks": 24,
    // Maximum center movement for portal landmarks, in blocks.
    "portalLandmarkMaxCenterShiftOnUpdateBlocks": 12,
    // Maximum merge distance for point-like places, in blocks.
    "pointPlaceMaxMergeDistanceBlocks": 24,
    // Maximum radius for point-like places, in blocks.
    "pointPlaceMaxClusterRadiusBlocks": 16,
    // Maximum center movement for point-like places, in blocks.
    "pointPlaceMaxCenterShiftOnUpdateBlocks": 8,
    // If true, deleted places leave markers that prevent auto-recreation.
    "deletedPlaceSuppressionEnabled": true,
    // How long deleted markers prevent auto-recreation, in Minecraft days. -1 forever, 0 disables.
    "deletedPlaceSuppressionDays": -1,
    // Extra spacing rules for sparse place types. Existing places are not renamed or removed.
    "spacing": {
      // If true, applies per-place-type spacing before creating new places.
      "enabled": true,
      // Minimum distance from another place of the same type before a new place can be created. Values below 0 are clamped.
      "sameTypeMinDistanceBlocks": {
        // GENERAL_LANDMARK is intentionally sparse because it represents casual travel/activity. Increase if generic places are too dense; decrease for a denser map.
        "GENERAL_LANDMARK": 256
      },
      // Minimum distance from any existing NamedPlace before this place type can be created. Only configured types are affected. Values below 0 are clamped.
      "anyPlaceMinDistanceBlocks": {
        // Prevents generic landmarks from cluttering around more specific named places.
        "GENERAL_LANDMARK": 96
      },
      // Distance where a nearby candidate may update an existing place instead of creating a new one. It is clamped to the same-type spacing distance.
      "mergeDistanceBlocks": {
        // GENERAL_LANDMARK candidates beyond this distance are suppressed instead of moving an existing landmark across the map.
        "GENERAL_LANDMARK": 64
      }
    }
  },
  // Legacy rarity and minimum thresholds.
  "thresholds": {
    // Threshold value used for rarity or legacy generation checks.
    "namedPlaceScore": 25.0,
    // Threshold value used for rarity or legacy generation checks.
    "rarePlaceScore": 75.0,
    // Threshold value used for rarity or legacy generation checks.
    "legendaryPlaceScore": 150.0,
    // Threshold value used for rarity or legacy generation checks.
    "mythicPlaceScore": 300.0,
    // Threshold value used for rarity or legacy generation checks.
    "minimumUniqueVisitors": 1,
    // Threshold value used for rarity or legacy generation checks.
    "minimumEvents": 3
  },
  // Raw event counts required before a place can become a candidate.
  "requiredCounts": {
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "playerDeathsForDeathSite": 5,
    // Minimum accepted combat events in the local cluster before a battlefield can generate. Anti-farm still filters repetitive farm-like kills.
    "hostileKillsForBattlefield": 8,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "passiveKillsForSlaughterField": 30,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "pvpDeathsForPvpArena": 5,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "valuableBlocksForMiningSite": 5,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "portalUsesForLandmark": 16,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "visitsForGeneralLandmark": 80,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "blocksPlacedForSettlementCandidate": 250,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "respawnPointsForSettlementCandidate": 3,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "bossKillsForBossSite": 1,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "petDeathsForPetMemorial": 1,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "namedMobDeathsForMemorial": 1,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "raidWinsForRaidSite": 1,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "firstDimensionEntryForDiscovery": 1,
    // Required raw count. Higher values make this place type rarer. Values below 1 are clamped.
    "firstMajorDiscovery": 1
  },
  // Score thresholds required before a place can become a candidate.
  "scoreThresholds": {
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "deathSite": 100.0,
    // Controls how much local combat is required before a battlefield is named. Lower values make combat sites appear more often. Anti-farm still filters repetitive farm-like kills.
    "battlefield": 56.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "slaughterField": 180.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "pvpArena": 100.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "miningSite": 100.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "portalLandmark": 140.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "generalLandmark": 240.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "settlement": 250.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "firstDiscovery": 20.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "bossSite": 30.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "petMemorial": 20.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "namedMobMemorial": 20.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "raidSite": 40.0,
    // Required score. Higher values make this place type rarer. Negative or non-finite values are clamped to 0.
    "dimensionThreshold": 30.0
  },
  // Player-facing display settings.
  "display": {
    // Shows discovery messages when places are found.
    "discoveryMessages": true,
    // Shows coordinates in player-facing place messages.
    "showCoordinates": false,
    // Shows place rarity in player-facing messages.
    "showRarity": true,
    // Radius used for nearby place checks, in blocks.
    "nearbyPlaceRadiusBlocks": 128,
    // Maximum places shown per /places list page.
    "maxPlacesInList": 20
  },
  // Performance limits. The mod remains event-driven and does not scan the world.
  "performance": {
    // Maximum dirty chunks scored per server tick.
    "maxScoreEvaluationsPerTick": 4,
    // Cooldown before the same chunk can create candidate logs again, in ticks. 0 disables this cooldown.
    "candidateGenerationCooldownTicks": 1200,
    // Maximum cluster radius for neighboring candidate chunks, in chunks.
    "maxClusterRadiusChunks": 2,
    // How often player visits are sampled, in ticks. Values below 20 reset to the safe default 400.
    "visitSampleIntervalTicks": 400,
    // How often display checks run, in ticks. Values below 20 reset to the safe default 100.
    "displayCheckIntervalTicks": 100,
    // How often structure discovery checks run for a player, in ticks. Values below 20 reset to the safe default 200.
    "structureDiscoveryCheckIntervalTicks": 200
  },
  // Event collection settings. These affect which events are counted before generation.
  "eventCollection": {
    // If false, future creative-mode event hooks may be ignored for automatic generation.
    "countCreativeModeEvents": true
  },
  // Anti-farm protection for repeated mob kills.
  "antiFarm": {
    // Anti-farm tuning. Higher limits are more permissive.
    "enabled": true,
    // Anti-farm tuning. Higher limits are more permissive.
    "repeatEventCooldownSeconds": 120,
    // Anti-farm tuning. Higher limits are more permissive.
    "samePositionRadiusBlocks": 8,
    // Anti-farm tuning. Higher limits are more permissive.
    "maxEventsPerPlayerPerMinute": 12,
    // Anti-farm tuning. Higher limits are more permissive.
    "maxKillsPerSmallAreaInTenMinutes": 40,
    // Anti-farm tuning. Higher limits are more permissive.
    "minimumSamplesForVarianceChecks": 8,
    // Anti-farm tuning. Higher limits are more permissive.
    "minimumPlayerPositionSpreadBlocks": 1.5,
    // Anti-farm tuning. Higher limits are more permissive.
    "minimumMobDeathPositionSpreadBlocks": 1.5,
    // Anti-farm tuning. Higher limits are more permissive.
    "sameEntityTypeKillThreshold": 16,
    // Anti-farm tuning. Higher limits are more permissive.
    "strictMode": false,
    // Anti-farm tuning. Higher limits are more permissive.
    "localSuppressionWindowSeconds": 600,
    // Anti-farm tuning. Higher limits are more permissive.
    "strictModeMinimumKills": 10,
    // Anti-farm tuning. Higher limits are more permissive.
    "strictModeSameEntityTypeRatio": 0.8,
    // Anti-farm tuning. Higher limits are more permissive.
    "strictModeMaximumPlayerSpreadBlocks": 2.5,
    // Anti-farm tuning. Higher limits are more permissive.
    "strictModeMaximumMobSpreadBlocks": 4.0,
    // Anti-farm tuning. Higher limits are more permissive.
    "debugFarmRejections": false,
    // Anti-farm tuning. Higher limits are more permissive.
    "repeatedEventScoreMultiplier": 0.25
  },
  // Naming settings for newly generated places. Existing places keep saved recipes.
  "naming": {
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "enabled": true,
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "enableNamePacks": true,
    // Default naming style for newly generated places. Unknown styles fall back to vanilla_adventure.
    "defaultStyle": "vanilla_adventure",
    // Styles available for random or weighted style selection. Unknown styles are ignored/fixed safely.
    "enabledStyles": [
      "vanilla_adventure"
    ],
    // How naming style is selected: DEFAULT_ONLY, RANDOM_ENABLED, WEIGHTED, or PER_PLACE_TYPE.
    "styleSelectionMode": "DEFAULT_ONLY",
    // Weights used when styleSelectionMode is WEIGHTED.
    "styleWeights": {
      // Style weight. 0 means this style will not be selected by weighted mode. Negative values are clamped to 0.
      "vanilla_adventure": 100,
      // Style weight. 0 means this style will not be selected by weighted mode. Negative values are clamped to 0.
      "dark_fantasy": 0,
      // Style weight. 0 means this style will not be selected by weighted mode. Negative values are clamped to 0.
      "cozy_survival": 0,
      // Style weight. 0 means this style will not be selected by weighted mode. Negative values are clamped to 0.
      "epic_mythology": 0,
      // Style weight. 0 means this style will not be selected by weighted mode. Negative values are clamped to 0.
      "neutral_server": 0,
      // Style weight. 0 means this style will not be selected by weighted mode. Negative values are clamped to 0.
      "funny_community": 0
    },
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "allowMixedStyleTokens": false,
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "existingPlacesKeepOriginalStyle": true,
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "allowAutoRenameOnCauseShift": false,
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "allowPerPlaceTypeStyleOverrides": true,
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "placeTypeStyleOverrides": {},
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "fallbackName": "Unnamed Place",
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "maxNameLength": 48,
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "duplicateNameAvoidanceRadiusBlocks": 192,
    // Naming option. Existing saved NameRecipe data is not regenerated automatically.
    "allowPlayerNamesInGeneratedNames": false
  },
  // Command permission settings.
  "commands": {
    // OP level required for admin commands. Valid range: 0 to 4.
    "requiredOpLevel": 2
  },
  // Controls automatic generation of each place type.
  "placeTypes": {
    // If true, existing disabled-type places are still shown to players.
    "displayExistingWhenDisabled": true,
    // If true, OPs can manually create disabled place types.
    "allowManualCreateWhenDisabled": true,
    // These toggles control automatic generation only. They do not delete existing places.
    "autoGeneration": {
      // Places created from repeated player deaths. Environment decides surface/cave/water/mountain naming.
      "DEATH_SITE": true,
      // Places created from combat with hostile or neutral mobs.
      "BATTLEFIELD": true,
      // Places created from repeated passive mob kills. Anti-farm checks still apply.
      "SLAUGHTER_FIELD": true,
      // Places created from repeated PvP deaths/kills. Mostly useful on servers.
      "PVP_ARENA": true,
      // Places created from valuable block mining, such as diamond ore or ancient debris.
      "MINING_SITE": true,
      // Places created from frequent portal or dimension travel.
      "PORTAL_LANDMARK": true,
      // Fallback landmarks created from repeated visits or mixed low-specificity activity.
      "GENERAL_LANDMARK": true,
      // World-first discoveries, such as first Nether entry, first diamond, first stronghold.
      "FIRST_DISCOVERY": true,
      // Places created from boss or boss-like mob kills.
      "BOSS_SITE": true,
      // Places created from pet deaths. Rare/sentimental place type.
      "PET_MEMORIAL": true,
      // Places created from deaths of custom-named mobs.
      "NAMED_MOB_MEMORIAL": true,
      // Places created from raid victories or raid-related events.
      "RAID_SITE": true,
      // Places created from major dimension transition milestones.
      "DIMENSION_THRESHOLD": true,
      // Places created from base-like activity such as building and respawn points.
      "SETTLEMENT": true,
      // Manual/custom places created by commands or external integrations.
      "CUSTOM": true
    }
  },
  // Biome theme mapping for generic landmarks. Useful for modded biomes later.
  "biomeThemes": {
    // If true, biome metadata is used when naming general landmarks.
    "enabled": true,
    // If true, GENERAL_LANDMARK names may use the biome at the place center.
    "useBiomeForGeneralLandmarks": true,
    // Fallback biome group when a biome is missing or unmapped.
    "unknownBiomeFallbackGroup": "unknown",
    // Maps biome ids to simple groups like forest, desert, plains, nether, or end.
    "mappings": {
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:plains": "plains",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:sunflower_plains": "plains",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:forest": "forest",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:flower_forest": "forest",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:birch_forest": "birch_forest",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:old_growth_birch_forest": "birch_forest",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:dark_forest": "dark_forest",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:taiga": "taiga",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:old_growth_pine_taiga": "taiga",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:old_growth_spruce_taiga": "taiga",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:snowy_plains": "snowy",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:ice_spikes": "snowy",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:snowy_taiga": "snowy",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:desert": "desert",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:savanna": "savanna",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:savanna_plateau": "savanna",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:jungle": "jungle",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:sparse_jungle": "jungle",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:bamboo_jungle": "jungle",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:swamp": "swamp",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:mangrove_swamp": "mangrove_swamp",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:stony_peaks": "mountain",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:jagged_peaks": "mountain",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:frozen_peaks": "mountain",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:meadow": "meadow",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:cherry_grove": "cherry_grove",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:river": "river",
      // Biome id to biome group. Add modded biome ids here for custom packs.
      "minecraft:frozen_river": "river",
