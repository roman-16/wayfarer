set shell := ["bash", "-euo", "pipefail", "-c"]

modVersion := `sed --quiet 's/^mod_version=//p' mod/gradle.properties`
packVersion := `sed --quiet 's/^version = "\(.*\)"$/\1/p' pack/pack.toml`
jar := "mod/build/libs/wayfarer-" + modVersion + ".jar"

[doc("Build the Wayfarer mod jar")]
build:
    cd mod && ./gradlew build

[doc("Remove everything generated by builds and runs")]
clean:
    rm --recursive --force build dist mod/build mod/run

[doc("Record the exaroton server's console, status, memory, tick time, log and world sizes into exaroton/ until interrupted")]
exaroton server="":
    python3 scripts/exaroton.py {{ server }}

[doc("Boot the whole pack on a headless dedicated server after auditing its jars, and check the world with /locate")]
boot: build
    python3 scripts/instance.py server build/server {{ jar }}
    python3 scripts/audit.py build/server/mods
    python3 scripts/boot.py build/server

[doc("Run the mod's game tests headless")]
gametest:
    cd mod && ./gradlew runGameTestServer

[doc("Regenerate the shrines, structure sets, templates, removals, textures and the quest book from their sources and balance.toml")]
generate:
    python3 generator/generate.py

[doc("Fix and format everything fixable, then lint with no findings allowed")]
lint: generate
    ruff format generator scripts
    ruff check --fix generator scripts
    taplo format balance.toml generator/*.toml
    just --fmt --unstable
    cd pack && packwiz refresh
    python3 scripts/rules.py
    cd mod && ./gradlew compileJava compileDevJava

[doc("Export the CurseForge-format client zip and the server pack into dist/")]
pack: build
    #!/usr/bin/env bash
    set -euo pipefail
    rm --recursive --force build/pack dist
    mkdir --parents build dist
    cp --recursive pack build/pack
    cp {{ jar }} build/pack/mods/
    (cd build/pack && packwiz refresh && packwiz curseforge export --yes --output "../../dist/Wayfarer-{{ packVersion }}.zip")
    python3 scripts/instance.py server build/server {{ jar }}
    python3 -c 'import shutil, sys; shutil.make_archive(sys.argv[1], "zip", sys.argv[2])' "dist/Wayfarer-{{ packVersion }}-server" build/server

[doc("Open the pack in a dev client on a fresh natural world, played in survival the way a player meets it; `just play lean` loads only the Wayfarer mod and what it needs, in a world of its own")]
play mode="full":
    python3 scripts/instance.py client build/client --mode {{ mode }}
    rm --recursive --force build/client/saves/play{{ if mode == "lean" { "-lean" } else { "" } }}
    cd mod && WAYFARER_LEAN={{ if mode == "lean" { "true" } else { "false" } }} LD_LIBRARY_PATH="$DEVBOX_PACKAGES_DIR/lib:/run/opengl-driver/lib" ./gradlew runPlay

[doc("Run the pack's dedicated server locally")]
server: build
    python3 scripts/instance.py server build/server {{ jar }}
    cd build/server && printf 'eula=true\n' > eula.txt && bash run.sh --nogui

[doc("Walk journeys on fresh headless servers, always to the nearest shrine not yet taken, and print each tier's legs against balance.toml's targets; `just survey apply` writes the tuned spacings")]
survey apply="": build
    python3 scripts/instance.py server build/server {{ jar }}
    python3 scripts/boot.py build/server --survey 4 {{ if apply == "apply" { "--apply" } else { "" } }}

[doc("Open the pack in a dev client in the showroom: a flat dimension rebuilt each launch with every shrine and item and a compass demo, beside an empty workshop and a kept natural world; `just showroom lean` loads only the Wayfarer mod and what it needs, in a save of its own")]
showroom mode="full":
    python3 scripts/instance.py client build/client --mode {{ mode }}
    rm --recursive --force build/client/saves/showroom{{ if mode == "lean" { "-lean" } else { "" } }}/dimensions/wayfarer/{showroom,workshop}
    cd mod && WAYFARER_LEAN={{ if mode == "lean" { "true" } else { "false" } }} LD_LIBRARY_PATH="$DEVBOX_PACKAGES_DIR/lib:/run/opengl-driver/lib" ./gradlew runShowroom

[doc("Write everything the pack contains, from every mod, into build/reports/: every registry with its entries, the content of every data-driven one, every tag and every recipe; starts the dev server and stops it after")]
registries:
    python3 scripts/server.py start
    python3 scripts/server.py run "wayfarer registries {{ justfile_directory() }}/build/reports"
    python3 scripts/server.py stop

[doc("Unpack Minecraft's and NeoForge's code with Parchment names and every mod decompiled with Vineflower into build/sources/, for searching with rg; only what changed is redone")]
sources:
    cd mod && ./gradlew createMinecraftArtifacts vineflower
    python3 scripts/instance.py client build/client
    python3 scripts/sources.py

[doc("Run the game tests, then the boot test")]
test: gametest boot

[doc("Move every mod, tool and dependency to its newest version, then prove the pack still holds")]
update:
    cd pack && packwiz update --all --yes
    devbox update
    just lint
    just test
