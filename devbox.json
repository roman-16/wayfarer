{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": {
    "alsa-lib": "latest",
    "imagemagick": "latest",
    "jdk": "21",
    "just": "latest",
    "libGL": "latest",
    "libpulseaudio": "latest",
    "packwiz": "latest",
    "python": "3.14",
    "ripgrep": "latest",
    "ruff": "latest",
    "taplo": "latest",
    "xorg.libX11": "latest",
    "xorg.libXcursor": "latest",
    "xorg.libXext": "latest",
    "xorg.libXi": "latest",
    "xorg.libXrandr": "latest",
    "xorg.libXxf86vm": "latest"
  },
  "shell": {
    "init_hook": [
      "if [ -f .env ]; then set -a; . ./.env; set +a; fi"
    ]
  }
}
